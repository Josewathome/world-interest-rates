# --- Database (production: free Turso account) ---
# Leave both blank for local dev — falls back to a local SQLite file at ./data/local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Public developer API auth ---
# Comma-separated list of accepted API keys (generate with: openssl rand -hex 32)
API_KEYS=change-me-dev-key

# --- Internal sync trigger auth (separate from API_KEYS, used only by your own cron pinger) ---
SYNC_SECRET=change-me-sync-secret

# --- Free data source keys ---
# FRED: register free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Scheduling ---
# Cron expression for the in-process scheduler. Belt-and-suspenders alongside
# the external pinger described in the README (recommended on free hosts that
# sleep when idle).
SYNC_CRON=*/30 * * * *
# Set to "true" to disable the in-process cron entirely and rely only on the
# external pinger hitting POST /internal/sync.
DISABLE_INTERNAL_CRON=false

PORT=3000
